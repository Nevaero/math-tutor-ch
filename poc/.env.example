# Copier en .env (jamais versionné). Jeton : Manager Infomaniak > API > jeton avec le scope « ai-tools ».
LEO_INFOMANIAK_API_TOKEN=
LEO_INFOMANIAK_PRODUCT_ID=

# Modèles : lister avec  python -m leo.models
LEO_CHAT_MODEL=Qwen/Qwen3.5-122B-A10B-FP8
LEO_VISION_MODEL=
LEO_EMBEDDING_MODEL=

# Prix CHF par million de tokens (grille Infomaniak), pour l'estimation de coût
LEO_PRICE_IN_PER_MTOK=0
LEO_PRICE_OUT_PER_MTOK=0
